{
  "name": "@beremaran/pi-goal",
  "version": "0.1.0",
  "description": "Persistent, independently evaluated /goal workflows for Pi",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Berke Arslan",
    "url": "https://github.com/beremaran"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beremaran/pi-goal.git"
  },
  "bugs": {
    "url": "https://github.com/beremaran/pi-goal/issues"
  },
  "homepage": "https://github.com/beremaran/pi-goal#readme",
  "funding": "https://github.com/sponsors/beremaran",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "goal",
    "autonomous-agent",
    "developer-tools"
  ],
  "files": [
    "extensions",
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run format:check && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run typecheck",
    "prepublishOnly": "npm run check"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-goal.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typebox": "^1.3.10"
  }
}
